{
    "name": "bhavcopy-scraper",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "kysely-codegen": "kysely-codegen --camel-case --out-file src/kysely/types.ts",
        "kysely": "kysely -c src/kysely/config.ts",
        "dev": "tsx watch src/app.ts",
        "build": "tsc --noEmit && tsup src/app.ts --format esm --target esnext --clean",
        "start": "node dist/app.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc --noEmit --watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shibisuriya/bhavcopy-scraper.git"
    },
    "keywords": [],
