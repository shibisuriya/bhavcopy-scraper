    "type": "module",
    "bugs": {
        "url": "https://github.com/shibisuriya/bhavcopy-scraper/issues"
    },
    "homepage": "https://github.com/shibisuriya/bhavcopy-scraper#readme",
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "kysely-codegen": "^0.20.0",
        "kysely-ctl": "^0.22.0",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "axios": "^1.21.0",
        "date-fns": "^4.4.0",
